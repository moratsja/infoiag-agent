        <rdfs:domain rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#Country"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ewill/ontologies/2026/8/projectOntology#hasCapital -->

